---
import publications from "../data/publications.json";

type Entry = {
  id: number;
  type: number;
  title: string;
  author: string;
  confname: string;
  urlpaper: string | null;
  urlslides: string | null;
  urlcite: string | null;
  cite: number;
  place: number | string | null;
  year: number;
  text: string | null;
  video: string | null;
  cluster: string | null;
  urlpdf: string | null;
  urlaward: string | null;
  hidden: number;
  featured?: number;
};

const entries = publications as Entry[];

const TYPE_LABELS: Record<number, string> = {
  1: "Conference",
  2: "Journal",
  3: "Preprint",
  4: "Book Chapter",
};

const allEntriesSorted = [...entries].sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  return a.id - b.id;
});
const years = Array.from(new Set(allEntriesSorted.map((e) => e.year))).sort(
  (a, b) => b - a,
);
const types = Array.from(new Set(allEntriesSorted.map((e) => e.type))).sort();
const totalCitations = allEntriesSorted.reduce((sum, e) => sum + (e.cite || 0), 0);
const totalPapers = allEntriesSorted.length;
const hIndex = 11;
const i10Index = 11;

const media: Array<[string, string, string]> = [
  [
    "https://www.scientificamerican.com/article/can-you-hear-me-now-how-to-protect-yourself-from-voice-hackers/",
